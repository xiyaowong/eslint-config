{
  "name": "@wongxy/eslint-config",
  "type": "module",
  "version": "4.0.2",
  "description": "xiyaowong's eslint config",
  "author": "xiyaowong (https://github.com/xiyaowong)",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nr typegen && tsdown --clean --dts",
    "stub": "tsdown --format esm",
    "watch": "tsdown --watch",
    "dev": "tsdown --watch & eslint-flat-config-viewer",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "prepack": "pnpm run build",
    "release": "bumpp && pnpm publish",
    "inspect": "nlx @eslint/config-inspector",
    "typegen": "esno scripts/typegen.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@next/eslint-plugin-next": "^16.0.1",
    "@unocss/eslint-plugin": "^66.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.5"
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "eslint-flat-config-utils": "^3.2.0",
    "local-pkg": "^1.2.1"
  },
  "devDependencies": {
    "@antfu/ni": "^30.6.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.13.6",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "eslint-typegen": "^2.3.1",
    "esno": "^4.8.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  }
}
